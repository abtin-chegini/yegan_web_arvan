# Cloudflare Pages / Workers Static Assets. Next.js copies this file to out/.
# Cache file bytes only; animation state and React lifecycles are unchanged.
# Keep patterns disjoint: Cloudflare combines headers from matching rules.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800, must-revalidate

/image/*
  Cache-Control: public, max-age=86400, must-revalidate

/stroke_svg/*
  Cache-Control: public, max-age=86400, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/about*
  Cache-Control: public, max-age=0, must-revalidate

/contact*
  Cache-Control: public, max-age=0, must-revalidate

/portfolio*
  Cache-Control: public, max-age=0, must-revalidate

/projects/*
  Cache-Control: public, max-age=0, must-revalidate

/tst*
  Cache-Control: public, max-age=0, must-revalidate

/404*
  Cache-Control: public, max-age=0, must-revalidate

/_not-found*
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/yeganeh_logo.svg
  Cache-Control: public, max-age=86400, must-revalidate

/next.svg
  Cache-Control: public, max-age=86400, must-revalidate

/vercel.svg
  Cache-Control: public, max-age=86400, must-revalidate

/window.svg
  Cache-Control: public, max-age=86400, must-revalidate

/file.svg
  Cache-Control: public, max-age=86400, must-revalidate

/globe.svg
  Cache-Control: public, max-age=86400, must-revalidate
